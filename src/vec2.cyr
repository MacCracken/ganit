# vec2.cyr -- 2D f64 vector type
# Usage: include "lib/vec2.cyr"
# Requires: alloc.cyr, math.cyr
#
# Heap-allocated: { x: f64, y: f64 } = 16 bytes

#derive(accessors)
struct HVec2 { x; y; }

#must_use
fn hvec2_new(x, y) {
    var v = alloc(16);
    store64(v, x);
    store64(v + 8, y);
    return v;
}

#must_use
fn hvec2_zero() { return hvec2_new(0, 0); }
#must_use
fn hvec2_one() { return hvec2_new(F64_ONE, F64_ONE); }
#must_use
fn hvec2_splat(s) { return hvec2_new(s, s); }

# ================================================================
# Arithmetic
# ================================================================

#must_use
fn hvec2_add(a, b) {
    return hvec2_new(f64_add(HVec2_x(a), HVec2_x(b)), f64_add(HVec2_y(a), HVec2_y(b)));
}

#must_use
fn hvec2_sub(a, b) {
    return hvec2_new(f64_sub(HVec2_x(a), HVec2_x(b)), f64_sub(HVec2_y(a), HVec2_y(b)));
}

#must_use
fn hvec2_mul(a, b) {
    return hvec2_new(f64_mul(HVec2_x(a), HVec2_x(b)), f64_mul(HVec2_y(a), HVec2_y(b)));
}

#must_use
fn hvec2_scale(v, s) {
    return hvec2_new(f64_mul(HVec2_x(v), s), f64_mul(HVec2_y(v), s));
}

#must_use
fn hvec2_neg(v) {
    return hvec2_new(f64_neg(HVec2_x(v)), f64_neg(HVec2_y(v)));
}

# ================================================================
# Products and norms
# ================================================================

#must_use
fn hvec2_dot(a, b) {
    return f64_add(f64_mul(HVec2_x(a), HVec2_x(b)), f64_mul(HVec2_y(a), HVec2_y(b)));
}

#must_use
fn hvec2_length_sq(v) { return hvec2_dot(v, v); }

#must_use
fn _hvec2_len_scaled(v) {
    var x = HVec2_x(v);
    var y = HVec2_y(v);
    var mx = f64_max(f64_abs(x), f64_abs(y));
    if (f64_gt(mx, 0) == 0) { return mx; }
    # ⚠ Inf/Inf is NaN, so the infinity contract needs its own exit here.
    if (f64_eq(mx, F64_POS_INF) == 1) { return mx; }
    var xs = f64_div(x, mx);
    var ys = f64_div(y, mx);
    return f64_mul(mx, f64_sqrt(f64_add(f64_mul(xs, xs), f64_mul(ys, ys))));
}

# ⛔ 2.17.0 — THIS SQUARED BEFORE SUMMING, AND LOST 537 BINADES AT THE BOTTOM AND
# 512 AT THE TOP. `x*x` underflows to zero for any component below 2^-537 and
# overflows to +Inf above 2^511, so a perfectly ordinary vector got a length of
# exactly 0 or exactly +Inf. ⚠ And it was materially wrong BEFORE it reached
# either: a SUBNORMAL sum has already lost most of its mantissa, so the answer is
# finite, plausible and wrong — measured 11.8% out at 2^-539, with nothing to
# signal it. That silent band is the dangerous third of the class.
# [measured: two-sided binade sweep, 2026-09-10]
#
# ⭐ FAST PATH, NOT UNCONDITIONAL SCALING. The naive sum announces its own failure:
# it is subnormal, zero or +Inf exactly when it cannot be trusted, and exact
# otherwise. So take it when it is NORMAL and rescale only when it is not.
# Measured: unconditional scaling costs **+119%** on this helper; the fast path
# costs **+12%** and is not distinguishable in any of the 72 tracked benchmarks
# (median delta -0.03%, the largest move being a row that never calls it).
# ⚠ The trigger is `< F64_TINY`, NOT `== 0` — measured, an `== 0` trigger leaves
# the subnormal band up to 11.8% wrong.
# ⚠ And the `+Inf` short-circuit inside the helper is REQUIRED: without it
# `Inf/Inf` is NaN and the documented infinity contract regresses.
# costs **+12%** and is not distinguishable in any of the 72 tracked benchmarks.
# [measured: 1106-scale two-sided sweep; naive wrong at 60, guarded at 0]
fn hvec2_length(v) {
    var ls = hvec2_length_sq(v);
    if (f64_lt(ls, F64_TINY) == 1) { return _hvec2_len_scaled(v); }
    if (f64_eq(ls, F64_POS_INF) == 1) { return _hvec2_len_scaled(v); }
    return f64_sqrt(ls);
}

#must_use
fn hvec2_normalize(v) {
    var len = hvec2_length(v);
    # ⛔ `len` is a LENGTH — degree one in the caller's units — and this tested it
    # against an absolute 1e-12, so a perfectly good short vector normalised to
    # the ZERO VECTOR: not an error value, just a wrong answer with no length.
    # ⭐ What fails is `1 / len`, so test THAT — and test it for OVERFLOW ONLY.
    # ⛔ The obvious `f64_lt(|inv|, F64_POS_INF) == 0` is wrong here and
    # `tests/abuse.tcyr` says so out loud: it is false for NaN too, so it would
    # silently zero a NaN vector, and this API's documented contract is **NaN in,
    # NaN out**. `f64_eq(|inv|, +Inf)` catches len = 0 and any len too small to
    # invert, while a NaN falls through and propagates as the contract requires.
    # ⚠ F64_TINY would be one binade too strict here: 1/2^-1023 is finite.
    # [measured: tests/foundation.tcyr normalize scale sweep, 2026-09-09]
    var inv = f64_div(F64_ONE, len);
    if (f64_eq(f64_abs(inv), F64_POS_INF) == 1) { return hvec2_zero(); }
    return hvec2_scale(v, inv);
}

#must_use
fn hvec2_distance(a, b) { return hvec2_length(hvec2_sub(a, b)); }

# ================================================================
# Interpolation
# ================================================================

#must_use
fn hvec2_lerp(a, b, t) {
    return hvec2_new(
      f64_add(HVec2_x(a), f64_mul(f64_sub(HVec2_x(b), HVec2_x(a)), t)),
      f64_add(HVec2_y(a), f64_mul(f64_sub(HVec2_y(b), HVec2_y(a)), t))
      );
}
