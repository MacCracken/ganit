# error.cyr -- hisab error codes
# Usage: include "lib/error.cyr"
#
# Replaces Rust's HisabError enum with integer error codes.
# Functions return 0 on success or a negative error code on failure.
# Pair with tagged.cyr for Result-like patterns.

var HSB_ERR_NONE             = 0;
var HSB_ERR_INVALID_TRANSFORM = (0 - 1);
var HSB_ERR_SINGULAR_MATRIX  = (0 - 2);
var HSB_ERR_OUT_OF_RANGE     = (0 - 3);
var HSB_ERR_DIVISION_BY_ZERO = (0 - 4);
var HSB_ERR_DEGENERATE       = (0 - 5);
var HSB_ERR_INVALID_INTERVAL = (0 - 6);
var HSB_ERR_ZERO_STEPS       = (0 - 7);
var HSB_ERR_NO_CONVERGENCE   = (0 - 8);
var HSB_ERR_SINGULAR_PIVOT   = (0 - 9);
var HSB_ERR_INVALID_INPUT    = (0 - 10);
# Allocation failed, or a request was rejected by a dimension cap before it could
# overflow. Added 2.6.14: solvers that size a working buffer from caller-supplied
# dimensions previously stored through alloc's null return instead of reporting.
var HSB_ERR_ALLOC            = (0 - 11);

# Tolerances
var EPSILON_F32 = 0x33D6BF95;               # 1e-7 as f32 bits (unused -- all math is f64)
var EPSILON_F64 = 0x3D719799812DEA11;        # 1e-12 as f64 bits

# The smallest MAGNITUDE whose reciprocal is still finite: DBL_MIN.
#
# ⭐ THE THIRD INSTANCE, so by this project's own rule it gets extracted. 2.10.2
# settled the rule this constant exists for — **guard exactly what makes the
# operation fail and nothing more; a threshold that needs a scale chosen for it
# IS the defect** — and three modules then wrote the same value under three
# different names: `_GEO_F64_TINY` (geo, 15 uses), `_AD_F64_TINY` (autodiff, 4)
# and `_QUAT_F64_TINY` (quat, 3). All three were byte-identical
# `0x0010_0000_0000_0000` and became aliases of this one, so the VALUE has a
# single definition and the constant gate has one literal to check instead of
# three.
# ⚠ `_QUAT_F64_TINY` IS GONE as of 2.17.0 — not renamed, RETIRED. Both of its
# uses were guards on a length or a squared length, and both turned out to be the
# wrong test once the norms below them stopped flushing: DBL_MIN is one binade too
# strict for a reciprocal, so `hquat_normalize` moved onto the overflow test the
# vec family uses, and `hquat_inverse` onto an exact zero. The alias had no
# remaining caller and an unused global is not free.
#
# ⚠ NOT A REPLACEMENT FOR `EPSILON_F64`. This is the right threshold when the
# guard protects a DIVISION and the only thing that can actually fail is a zero
# (or subnormal) denominator. `EPSILON_F64` remains right for a genuinely
# dimensionless, bounded quantity — a normalised cosine, a barycentric weight, a
# parameter in [0,1] — where an absolute tolerance means something.
var F64_TINY = 0x0010_0000_0000_0000;        # 2.2250738585072014e-308 (DBL_MIN)

# +Infinity, as a bit pattern.
#
# ⭐ THE FIFTH INSTANCE — this one was overdue. `_COL_F64_POS_INF`,
# `_SP_F64_POS_INF`, `_GA_F64_POS_INF` and `_GEO_F64_POS_INF` are byte-identical
# and are now aliases of this one, so the value has a single definition and the
# constant gate has one literal to check instead of five.
# ⚠ `interval.cyr` keeps its own `_IVL_F64_POS_INF` literal on purpose: it is one
# of the four fully STANDALONE modules and does not include `error`, so aliasing
# it here would be a dependency, not a de-duplication.
#
# ⭐ Its main use is not a sentinel but a GUARD. When the operation that can fail
# is a RECIPROCAL, `f64_lt(f64_abs(1/x), F64_POS_INF)` is the exact test: it is 1
# for every finite reciprocal and 0 for both +Inf and NaN, so one comparison
# rejects x = 0, any x too small to invert, and a NaN — with no scale chosen for
# it. ⚠ `F64_TINY` is NOT equivalent there and is one binade too strict:
# 1/2^-1023 = 2^1023 is finite, so DBL_MIN refuses inputs that work.
var F64_POS_INF = 0x7FF0_0000_0000_0000;     # +Infinity

fn hisab_is_err(code) {
    if (code < 0) { return 1; }
    return 0;
}
